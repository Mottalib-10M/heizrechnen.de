---
/** Ein Ort, an dem jede Rechnerart ihrem Komponenten zugeordnet wird (Rechnerseiten, Einbettung). */
import FoerderRechner from './calc/FoerderRechner';
import HeizkostenRechner from './calc/HeizkostenRechner';
import WpStromRechner from './calc/WpStromRechner';
import Co2Rechner from './calc/Co2Rechner';
import AufteilungRechner from './calc/AufteilungRechner';
import type { Locale } from '../i18n/routes';
import type { Tool } from '../lib/guide-types';
interface Props { tool?: Tool; lang: Locale; methodHref?: string; preset?: Record<string, never> }
const { tool, lang, methodHref, preset = {} } = Astro.props;
---
{tool === 'foerderung' && <FoerderRechner client:load lang={lang} methodHref={methodHref} preset={preset} />}
{tool === 'heizkosten' && <HeizkostenRechner client:load lang={lang} methodHref={methodHref} preset={preset} />}
{tool === 'wpstrom' && <WpStromRechner client:load lang={lang} methodHref={methodHref} />}
{tool === 'co2' && <Co2Rechner client:load lang={lang} methodHref={methodHref} preset={preset} />}
{tool === 'aufteilung' && <AufteilungRechner client:load lang={lang} methodHref={methodHref} />}
